# Local development only. Choose a password before starting Compose.
APP_ENV=development
POSTGRES_DB=waypoint
POSTGRES_USER=waypoint
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432
API_PORT=8000
WEB_PORT=3000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Required before issuing tokens; generate a random secret (at least 32 bytes).
# See apps/api/app/auth/README.md. Never commit the generated value.
JWT_SECRET_KEY=
JWT_ISSUER=waypoint-api
JWT_AUDIENCE=waypoint-clients
ACCESS_TOKEN_EXPIRE_MINUTES=30
