# Local development. Without a .env, `docker compose up` runs the reviewer demo instead
# (APP_ENV=demo, see DEMO-CREDENTIALS.md). Copying this file switches the demo off.
APP_ENV=development
# Demo login cards (web and Metro containers) only when APP_ENV=demo and DEMO_MODE=true.
DEMO_MODE=false
# Demo-only password used by `docker compose up` in demo mode (compose default: WaypointDemo#2026).
# DEMO_SEED_PASSWORD=
# Phone testing in the demo: your computer's LAN IP (default 10.0.2.2 = Android emulator).
# DEMO_HOST_IP=
# Your development database volume (the demo uses waypoint_demo_postgres_data).
POSTGRES_VOLUME=waypoint_postgres_data
POSTGRES_DB=waypoint
POSTGRES_USER=waypoint
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432
API_PORT=8000
WEB_PORT=3000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Required before issuing tokens; generate a random secret (at least 32 bytes).
# See apps/api/app/auth/README.md. Never commit the generated value.
JWT_SECRET_KEY=
JWT_ISSUER=waypoint-api
JWT_AUDIENCE=waypoint-clients
ACCESS_TOKEN_EXPIRE_MINUTES=30
