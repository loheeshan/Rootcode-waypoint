APP_NAME=waypoint-api
APP_ENV=development
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=waypoint
POSTGRES_USER=waypoint
POSTGRES_PASSWORD=change-me-local-only
# Optional alternative: a complete URL with percent-encoded credentials.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/waypoint
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Use the same generated signing key as root .env when running the API locally.
JWT_SECRET_KEY=
JWT_ISSUER=waypoint-api
JWT_AUDIENCE=waypoint-clients
ACCESS_TOKEN_EXPIRE_MINUTES=30
